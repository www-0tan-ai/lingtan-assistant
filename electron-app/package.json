{
  "name": "lingtan-assistant",
  "version": "0.6.0",
  "description": "Lingtan Assistant — Electron desktop wrapper for the Hermes Web UI",
  "main": "main.js",
  "private": true,
  "author": "Lingtan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/run-dev.cjs",
    "seed": "node scripts/build-seed.cjs",
    "predist": "node scripts/apply-lingtan-webui-patches.cjs && node scripts/build-seed.cjs",
    "predist:portable": "node scripts/apply-lingtan-webui-patches.cjs && node scripts/build-seed.cjs",
    "predist:dir": "node scripts/apply-lingtan-webui-patches.cjs && node scripts/build-seed.cjs",
    "predist:mac": "node scripts/apply-lingtan-webui-patches.cjs && node scripts/build-seed.cjs",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lingtan.assistant",
    "productName": "Lingtan Assistant",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../hermes-webui",
        "to": "hermes-webui",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.git/**",
          "!**/.github/**",
          "!tests/**",
          "!docs/**",
          "!CHANGELOG.md",
          "!ARCHITECTURE.md",
          "!HERMES.md",
          "!ROADMAP.md",
          "!SPRINTS.md",
          "!TESTING.md",
          "!THEMES.md",
          "!BUGS.md",
          "!docker*",
          "!Dockerfile*",
          "!ctl.sh",
          "!start.sh"
        ]
      },
      {
        "from": "seed",
        "to": "seed",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/.pytest_cache/**",
          "!**/.mypy_cache/**",
          "!**/.ruff_cache/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lingtan Assistant"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "title": "${productName} ${version}"
    }
  }
}
