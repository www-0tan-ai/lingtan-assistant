# Copy to deploy/.env and fill in.

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8650

# 容器名（与本机已有容器冲突时改这里；默认 lingtan-api / lingtan-ui）
# BACKEND_CONTAINER_NAME=lingtan-api
# FRONTEND_CONTAINER_NAME=lingtan-ui

# API server CORS：须与实际浏览器访问前端的 Origin 一致（含协议、主机、端口）。
# 公网示例：http://8.136.97.229:6121
API_SERVER_CORS_ORIGINS=http://localhost:8080

# 公网监听必须设置（至少 8 字符，勿用 changeme 等占位）。生成示例：openssl rand -hex 32
API_SERVER_KEY=

# 前端镜像构建（可选）：国内或弱网可设为镜像源，减轻 npm ci 中断
# NPM_REGISTRY=https://registry.npmmirror.com

# Optional runtime UID/GID mapping
HERMES_UID=10000
HERMES_GID=10000

# Model provider settings (example: Azure OpenAI compatible endpoint)
HERMES_DEFAULT_PROVIDER=custom
HERMES_DEFAULT_MODEL=gpt-5-mini
HERMES_BASE_URL=https://your-azure-openai-endpoint/openai/v1

# At least one provider key is required for chat to work.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
CUSTOM_API_KEY=
