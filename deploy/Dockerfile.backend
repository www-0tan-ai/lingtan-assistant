# 灵碳 / API-only 后端镜像：仅 Python + gateway（含 aiohttp api_server），不包含仓库根
# Dockerfile 中的 Node、Playwright、web/ui-tui 构建，避免弱网或镜像站不稳定时出现
# `npm ERR! network aborted`。
#
# 构建上下文应为仓库根目录（与 deploy/docker-compose.lingtan.yml 一致）。

FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uvbin

FROM python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    gosu \
    build-essential \
    curl \
    git \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -u 10000 -m -d /opt/data hermes

COPY --from=uvbin /usr/local/bin/uv /usr/local/bin/uv
COPY --from=uvbin /usr/local/bin/uvx /usr/local/bin/uvx

WORKDIR /opt/hermes

COPY . .

RUN chmod +x docker/entrypoint.sh \
    && uv venv /opt/hermes/.venv \
    && VIRTUAL_ENV=/opt/hermes/.venv uv pip install --no-cache -e ".[messaging]"

USER root
RUN chmod -R a+rX /opt/hermes

ENV HERMES_HOME=/opt/data \
    VIRTUAL_ENV=/opt/hermes/.venv \
    PATH="/opt/hermes/.venv/bin:${PATH}"

VOLUME ["/opt/data"]

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint.sh"]
CMD ["gateway", "run"]
